{
  "name": "indominus",
  "version": "1.0.0",
  "description": "Indominus Trail Series — a 2016 D3-powered landing page for a kids trail running event in Ecuador.",
  "private": true,
  "scripts": {
    "build": "sass --no-source-map src/scss/style.scss:src/css/style.css",
    "watch": "sass --watch src/scss/style.scss:src/css/style.css",
    "start": "npm run build && http-server src -p 4000 -c-1 -o",
    "dev": "npm run build && http-server src -p 4000 -c-1"
  },
  "keywords": [
    "d3",
    "ecuador",
    "trail-running",
    "2016"
  ],
  "author": "Xavier Reyes Ochoa <xareyesochoa@gmail.com> (http://www.xaviro.com)",
  "license": "MIT",
  "devDependencies": {
    "http-server": "^14.1.1",
    "sass": "^1.69.0"
  }
}
